# Flutter build outputs
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android
app/android/.gradle/
app/android/local.properties
app/android/captures/
app/android/app/build/

# iOS/macOS
app/ios/Pods/
app/macos/Pods/
app/.symlinks/

# Secrets — never commit (release keystore passwords live in app/android/
# key.properties, already covered by its own .gitignore; this covers
# anything else, e.g. secrets/sygnal-fcm-key.json, the Firebase service
# account key used by the Sygnal push gateway — see CLAUDE.md)
secrets/

# Other
*.log
.DS_Store
Thumbs.db
